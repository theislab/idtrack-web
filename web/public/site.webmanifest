{
  "name": "IDTrack",
  "short_name": "IDTrack",
  "description": "Convert gene identifiers through Ensembl's releases, genome assemblies and external databases, with the path that led to each answer.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#fafaf8",
