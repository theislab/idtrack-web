{
  "name": "idtrack-web-frontend",
  "private": true,
  "version": "0.1.2",
  "description": "The frontend of idtrack-web: convert gene identifiers through Ensembl releases in the browser.",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.ts && node scripts/site-files.ts && node scripts/compress.ts",
    "preview": "vite preview",
    "types": "node scripts/generate-types.ts",
    "types:check": "node scripts/generate-types.ts --check",
    "limitations": "node scripts/limitations.ts",
    "limitations:check": "node scripts/limitations.ts --check",
    "idtrack-docs": "node scripts/idtrack-docs.ts",
    "idtrack-docs:check": "node scripts/idtrack-docs.ts --check",
    "benchmarks": "node scripts/benchmarks.ts",
    "benchmarks:check": "node scripts/benchmarks.ts --check",
    "licences": "node scripts/licences.ts",
    "licences:check": "node scripts/licences.ts --check",
    "icons": "node scripts/icons.ts",
    "icons:check": "node scripts/icons.ts --check",
    "maintenance": "node scripts/maintenance.ts",
    "maintenance:check": "node scripts/maintenance.ts --check",
    "typecheck": "tsc -b --noEmit",
    "lint": "node scripts/check.ts --only prettier,eslint,stylelint",
    "lint:css": "stylelint \"**/*.css\"",
    "knip": "knip",
    "check": "node scripts/check.ts",
    "names": "node scripts/names.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "palette": "vitest run tests/palette.test.ts",
    "size": "node scripts/build-size.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "d3-scale": "4.0.3",
    "d3-selection": "3.0.1",
    "d3-transition": "3.0.2",
    "d3-zoom": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "knip": "6.45.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
