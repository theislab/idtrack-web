{
  "name": "idtrack-web-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "The frontend of idtrack-web: convert gene identifiers through Ensembl releases in the browser.",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "types": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check",
    "limitations": "node scripts/limitations.mjs",
    "limitations:check": "node scripts/limitations.mjs --check",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "palette": "node scripts/check-palette.mjs",
    "size": "node scripts/build-size.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "d3-scale": "4.0.3",
    "d3-selection": "3.0.1",
    "d3-transition": "3.0.2",
    "d3-zoom": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
