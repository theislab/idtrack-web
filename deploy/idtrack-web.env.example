# Configuration of idtrack-web (SETUP.md, "Configuration", explains every variable). Copy to idtrack-web.env on the
# node and fill in; that file holds credentials and is never committed (.gitignore: *.env).

# Where the graphs come from: s3 (Cloudflare R2) or directory (a folder with the same layout, mounted at /srv/store
# by deploy/compose.yaml; the Helmholtz virtual machine's store: SETUP.md, section 10.4). For directory, comment out
# the IDTRACK_WEB_S3_* lines.
IDTRACK_WEB_SOURCE=s3

# --- for IDTRACK_WEB_SOURCE=s3 (Cloudflare R2: an API token with "Object Read" on the bucket) ---
IDTRACK_WEB_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
IDTRACK_WEB_S3_BUCKET=<bucket>
IDTRACK_WEB_S3_REGION=auto
IDTRACK_WEB_S3_ACCESS_KEY_ID=<access key id>
IDTRACK_WEB_S3_SECRET_ACCESS_KEY=<secret access key>

# --- for IDTRACK_WEB_SOURCE=directory ---
# IDTRACK_WEB_DIRECTORY=/srv/store

# The organisms to load (empty: every organism of the manifest), and the workers. On a machine of 8 vCPU and 16 GB
# (the Helmholtz virtual machine, a Hetzner CPX42), all five with three workers measured 11.1 GB in use on the
# machine after 15 minutes of load (SETUP.md, section 10.7); fewer organisms or workers need less.
# IDTRACK_WEB_ORGANISMS=homo_sapiens,mus_musculus,sus_scrofa,macaca_mulatta,macaca_fascicularis
IDTRACK_WEB_WORKERS=3

# Bounds (the defaults are shown).
# IDTRACK_WEB_REQUEST_SECONDS=20
# IDTRACK_WEB_SEARCH_SECONDS=10
# IDTRACK_WEB_SEARCH_STATES=200000
# IDTRACK_WEB_BATCH_MAX=1000
# IDTRACK_WEB_IDENTIFIER_MAX_LENGTH=256
# IDTRACK_WEB_BODY_MAX_BYTES=1048576
# IDTRACK_WEB_RESPONSE_MAX_BYTES=33554432
# IDTRACK_WEB_RATE_PER_MINUTE=120
# IDTRACK_WEB_RATE_BURST=30
# IDTRACK_WEB_RATE_SEARCH_SECONDS=30
# IDTRACK_WEB_RATE_SEARCH_BURST_SECONDS=60
# IDTRACK_WEB_RATE_CONCURRENT_SEARCHES=2
# IDTRACK_WEB_QUEUE_MAX=64
# IDTRACK_WEB_HEAD_SECONDS=5
# IDTRACK_WEB_BODY_SECONDS=30
# IDTRACK_WEB_SEND_SECONDS=30
# IDTRACK_WEB_SENDING_MAX_BYTES=268435456
# IDTRACK_WEB_ANSWER_CACHE_BYTES=67108864
# The site's address, for the absolute links of /llms.txt and /llms-full.txt (compose sets it from IDTRACK_WEB_DOMAIN;
# set it here for the systemd service): https://<domain>
# IDTRACK_WEB_PUBLIC_URL=https://<domain>
# Where idtrack's documentation is published (default: Read the Docs' stable version); set it when it moves to a
# name of its own, e.g. https://docs.<domain>/.
# IDTRACK_WEB_DOCS_URL=https://idtrack.readthedocs.io/en/stable/
# The Google Analytics measurement id the site counts visits with, only after a visitor accepts (the same property as
# IDTrack's documentation on Read the Docs). Empty or unset: no analytics, and the page allows no other host.
IDTRACK_WEB_ANALYTICS_ID=G-FYKLWNJBVK
# Origins allowed to call the api from a browser: * (any page; the api is keyless and read-only), a list, or none.
# IDTRACK_WEB_CORS_ORIGINS=*
# IDTRACK_WEB_LOG_LEVEL=INFO
