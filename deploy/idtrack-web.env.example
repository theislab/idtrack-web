# Configuration of idtrack-web (SETUP.md, "Configuration", explains every variable). Copy to idtrack-web.env on the
# node and fill in; that file holds credentials and is never committed (.gitignore: *.env).

# Where the graphs come from: s3 (Cloudflare R2) or directory (a folder with the same layout, mounted at /srv/store).
IDTRACK_WEB_SOURCE=s3

# --- for IDTRACK_WEB_SOURCE=s3 (Cloudflare R2: an API token with "Object Read" on the bucket) ---
IDTRACK_WEB_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
IDTRACK_WEB_S3_BUCKET=<bucket>
IDTRACK_WEB_S3_REGION=auto
IDTRACK_WEB_S3_ACCESS_KEY_ID=<access key id>
IDTRACK_WEB_S3_SECRET_ACCESS_KEY=<secret access key>

# --- for IDTRACK_WEB_SOURCE=directory ---
# IDTRACK_WEB_DIRECTORY=/srv/store

# The organisms to load (empty: every organism of the manifest). Memory: all five with two workers measured 7 GB in
# all after use (SETUP.md, "Sizing"); fewer organisms or one worker need less.
# IDTRACK_WEB_ORGANISMS=homo_sapiens,mus_musculus,sus_scrofa,macaca_mulatta,macaca_fascicularis
IDTRACK_WEB_WORKERS=2

# Bounds (the defaults are shown).
# IDTRACK_WEB_REQUEST_SECONDS=20
# IDTRACK_WEB_SEARCH_SECONDS=10
# IDTRACK_WEB_SEARCH_STATES=200000
# IDTRACK_WEB_BATCH_MAX=1000
# IDTRACK_WEB_IDENTIFIER_MAX_LENGTH=256
# IDTRACK_WEB_BODY_MAX_BYTES=1048576
# IDTRACK_WEB_RESPONSE_MAX_BYTES=33554432
# IDTRACK_WEB_RATE_PER_MINUTE=120
# IDTRACK_WEB_RATE_BURST=30
# IDTRACK_WEB_QUEUE_MAX=64
# IDTRACK_WEB_LOG_LEVEL=INFO
