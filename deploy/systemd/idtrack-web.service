# idtrack-web as a systemd service on the node, without containers (SETUP.md, "Deploying without containers").
# The api runs from the environment built in /opt/idtrack-web/venv; Caddy (installed from its package) proxies to it
# with deploy/Caddyfile (`reverse_proxy 127.0.0.1:8000`).
[Unit]
Description=idtrack-web api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idtrack-web
Group=idtrack-web
EnvironmentFile=/etc/idtrack-web/idtrack-web.env
Environment=IDTRACK_WEB_HOST=127.0.0.1
Environment=IDTRACK_WEB_PORT=8000
Environment=IDTRACK_WEB_CACHE_DIR=/var/cache/idtrack-web
Environment=IDTRACK_WEB_FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/idtrack-web/venv/bin/idtrack-web serve
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=40
CacheDirectory=idtrack-web
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
ReadOnlyPaths=/
ReadWritePaths=/var/cache/idtrack-web

[Install]
WantedBy=multi-user.target
