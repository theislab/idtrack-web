# The server's settings on the Helmholtz virtual machine (SETUP.md, section 10.4): the graphs from the folder store on
# the machine's disk (deploy/compose.yaml mounts IDTRACK_WEB_STORE of deploy/.env at /srv/store), three workers
# (section 10.7). Installed as deploy/idtrack-web.env, readable by root only; it holds no secret. Every other setting
# keeps its default: deploy/idtrack-web.env.example lists them, SETUP.md, section 6, explains each.
IDTRACK_WEB_SOURCE=directory
IDTRACK_WEB_DIRECTORY=/srv/store
IDTRACK_WEB_WORKERS=3

# The Google Analytics measurement id the site counts visits with, only after a visitor accepts (SETUP.md, section 6).
IDTRACK_WEB_ANALYTICS_ID=G-FYKLWNJBVK
