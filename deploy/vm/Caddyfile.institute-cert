# Caddy in front of idtrack-web with the certificate given by the institute (SETUP.md, section 10.5):
# deploy/Caddyfile with the certificate and key read from files instead of obtained from Let's Encrypt; nothing else
# differs. The folder IDTRACK_WEB_TLS_DIR (deploy/vm/compose.institute-cert.yaml) holds cert.pem (the certificate,
# then the intermediate certificates) and key.pem; Caddy reads them at start, so after they are replaced:
# `sudo docker compose restart caddy`.
{
	servers {
		# A client must send its request's head within 10 s and its body within 30 s; an idle kept connection is
		# closed after 2 minutes. Heads over 64 KB are refused here (the api reads at most 64 KB of head, and answers
		# a path and query over 16 KB with 414 uri_too_long).
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 64KB
	}
	# Caddy's own messages (its start, certificates and renewals) go to its output. Every message about a request names
	# its client (the address and the headers), so each goes to a file of its own, kept as long as the access log
	# below, and none to the output (which Docker or the journal would keep longer): a request's error
	# (http.log.error), a handler's (http.handlers: a download the client broke off, an api that failed), the HTTP
	# server's own (http.stdlib: a failed handshake, with the client's address), the TLS handshake's (tls.handshake)
	# and, at the debug level, the events' (events: the client's greeting). The site's privacy page says so.
	log default {
		output stderr
		exclude http.log.error http.handlers http.stdlib tls.handshake events
	}
	log errors {
		output file {$IDTRACK_WEB_LOG_DIR:/data/logs}/errors.log {
			roll_at 00:00
			roll_size 100MiB
			roll_keep 6
			roll_keep_for 144h
		}
		format console
		include http.log.error http.handlers http.stdlib tls.handshake events
	}
}

{$IDTRACK_WEB_DOMAIN} {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem

	encode zstd gzip

	request_body {
		max_size 2MB
	}

	# The answers name neither the server nor the proxy (reverse_proxy would add `Via: 1.1 Caddy`).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	# The api: the compose service `api`, or (without containers) IDTRACK_WEB_UPSTREAM=127.0.0.1:8000 in Caddy's
	# environment (deploy/systemd/caddy-idtrack-web.conf).
	reverse_proxy {$IDTRACK_WEB_UPSTREAM:api:8000} {
		# Answered at once by whichever worker takes it, even while every worker is in a search; the api is marked
		# down only after three failed checks in a row.
		health_uri /api/v1/health
		health_interval 30s
		health_timeout 10s
		health_fails 3
		# A body is read whole by Caddy before the request is passed on, so a client that sends it slowly holds
		# Caddy's buffer, never an api worker (the api's own bound is 1 MiB; Caddy's is 2 MB above).
		request_buffers 2MB
		# A batch may take the api's whole request budget (IDTRACK_WEB_REQUEST_SECONDS, 20 s by default).
		transport http {
			read_timeout 90s
		}
	}

	# The access log: one line per request (the time, the client's address, the method, the address asked for with its
	# query, the request's headers but cookies and credentials, the status, the size, the time taken, the answer's
	# headers). A new file each midnight (UTC) and six earlier days kept: a line is deleted at most seven days after it
	# was written (the site's privacy page says so).
	log {
		output file {$IDTRACK_WEB_LOG_DIR:/data/logs}/access.log {
			roll_at 00:00
			roll_size 100MiB
			roll_keep 6
			roll_keep_for 144h
		}
		format console
	}

	# When the api cannot answer (stopped, restarting, or failing its health checks): the site's page of maintenance,
	# or for a program the api's own error (503 server_busy), never a bare error of the proxy. No script: the page
	# holds one style, allowed by its hash (api/tests/test_deploy.py keeps it equal to the file).
	handle_errors 502 503 504 {
		header {
			Retry-After 60
			Cache-Control no-store
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options nosniff
			-Server
		}
		@program path /api /api/* /llms.txt /llms-full.txt
		handle @program {
			# As the api's own answers: any page may read it, its wait included (the api's CORS, README.md).
			header {
				Content-Type "application/json"
				Access-Control-Allow-Origin *
				Access-Control-Expose-Headers Retry-After
			}
			respond `{"error":{"code":"server_busy","message":"The server is not answering at the moment (it restarts after an update or a maintenance); send the request again in a minute.","argument":null,"allowed":null,"details":null,"request_id":null,"retry_after":60,"allowance":null}}` 503
		}
		handle {
			header Content-Security-Policy "default-src 'none'; style-src 'sha256-gF2/K71BBGcqjGbwkbSp8hMJvL1LBZQExvXL14ihL8o='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			root * {$IDTRACK_WEB_MAINTENANCE_DIR:/etc/caddy}
			rewrite * /maintenance.html
			file_server {
				status 503
			}
		}
	}
}
