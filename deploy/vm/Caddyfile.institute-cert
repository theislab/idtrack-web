# Caddy in front of idtrack-web with the certificate given by the institute (SETUP.md, section 10.5):
# deploy/Caddyfile with the certificate and key read from files instead of obtained from Let's Encrypt; nothing else
# differs. The folder IDTRACK_WEB_TLS_DIR (deploy/vm/compose.institute-cert.yaml) holds cert.pem (the certificate,
# then the intermediate certificates) and key.pem; Caddy reads them at start, so after they are replaced:
# `sudo docker compose restart caddy`.
{
	servers {
		# A client must send its request's head within 10 s and its body within 30 s; an idle kept connection is
		# closed after 2 minutes. Heads over 64 KB are refused here (the api reads at most 64 KB of head, and answers
		# a path and query over 16 KB with 414 uri_too_long).
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 64KB
	}
}

{$IDTRACK_WEB_DOMAIN} {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem

	encode zstd gzip

	request_body {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The api: the compose service `api`, or (without containers) IDTRACK_WEB_UPSTREAM=127.0.0.1:8000 in Caddy's
	# environment (deploy/systemd/caddy-idtrack-web.conf).
	reverse_proxy {$IDTRACK_WEB_UPSTREAM:api:8000} {
		# Answered at once by whichever worker takes it, even while every worker is in a search; the api is marked
		# down only after three failed checks in a row.
		health_uri /api/v1/health
		health_interval 30s
		health_timeout 10s
		health_fails 3
		# A body is read whole by Caddy before the request is passed on, so a client that sends it slowly holds
		# Caddy's buffer, never an api worker (the api's own bound is 1 MiB; Caddy's is 2 MB above).
		request_buffers 2MB
		# A batch may take the api's whole request budget (IDTRACK_WEB_REQUEST_SECONDS, 20 s by default).
		transport http {
			read_timeout 90s
		}
	}

	log {
		output stdout
		format console
	}
}
