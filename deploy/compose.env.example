# The settings of deploy/compose.yaml itself, which compose reads from deploy/.env: copy this file to deploy/.env on
# the server and fill it in (SETUP.md, sections 10 and 11). The server's own settings are in deploy/idtrack-web.env.

# The image to run (deploy/build_image.sh <tag> names it idtrack-web:<tag>).
IDTRACK_WEB_IMAGE=idtrack-web:0.1.2

# The site's domain name: Caddy's certificate and the absolute links of /llms.txt are for it.
IDTRACK_WEB_DOMAIN=<domain>

# For IDTRACK_WEB_SOURCE=directory: the folder of the graph store on this machine (mounted read only at /srv/store).
IDTRACK_WEB_STORE=/srv/idtrack-web/store

# The compose files, ':'-separated, relative to deploy/: compose.yaml, then the overrides of this machine.
# The Helmholtz virtual machine (SETUP.md, section 10): the memory bound, and one of the three ways to its certificate:
#   Let's Encrypt (Caddy obtains and renews it):   compose.yaml:vm/compose.vm.yaml
#   a certificate given by the institute:           compose.yaml:vm/compose.vm.yaml:vm/compose.institute-cert.yaml
#   behind the institute's reverse proxy:           compose.yaml:vm/compose.vm.yaml:vm/compose.behind-proxy.yaml
# The Hetzner node (section 11): compose.yaml alone.
COMPOSE_FILE=compose.yaml:vm/compose.vm.yaml

# For vm/compose.institute-cert.yaml: the folder holding cert.pem (the certificate, then the intermediate
# certificates) and key.pem, readable by root only.
# IDTRACK_WEB_TLS_DIR=/etc/idtrack-web/tls

# For vm/compose.behind-proxy.yaml: the addresses (or networks) of the institute's reverse proxy, space-separated.
# IDTRACK_WEB_TRUSTED_PROXIES=<address> <address>
